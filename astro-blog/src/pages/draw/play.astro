---
import Layout from '../../layouts/Layout.astro';
import DrawPlay from '../../components/draw/DrawPlay';

const pageTitle = 'お絵描きチャレンジ｜30秒お絵描き採点ゲーム';
const metaDescription = '30秒の制限時間でお題を描くチャレンジ画面。好きな色のペンや消しゴムを使って、気軽に描いて採点へ進みます。';
---

<Layout
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  noSidebar={true}
  pageHeading="30秒お絵描きチャレンジ"
  hidePageHeader={true}
>
  <section class="draw-hero rounded-[2rem] p-4 sm:p-6">
    <h1 class="sr-only">30秒お絵描きチャレンジ</h1>
    <DrawPlay client:load />
  </section>
</Layout>
