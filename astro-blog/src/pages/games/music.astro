---
import Layout from '../../layouts/Layout.astro';
import MusicApp from '../../components/games/music/MusicApp';
import RelatedGames from '../../components/games/RelatedGames.astro';

const pageTitle = 'おんがくゲーム｜ミニゲーム';
const metaDescription = '音符を読む、リズムをたたく、音を聴き分ける、メロディをまねる。4つの短い音楽ゲームをブラウザで遊べます。';
---

<Layout pageTitle={pageTitle} metaDescription={metaDescription} noSidebar={true} hidePageHeader={true}>
  <MusicApp client:load />
  <section class="mt-10 grid gap-4 md:grid-cols-2">
    <article class="panel-muted p-5">
      <h2 class="mt-0 text-lg font-semibold">あそびかた</h2>
      <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">好きなカードを押すとゲーム画面が開きます。リズムは譜面を見てから「はじめる」を押してください。各ゲームは10問で一区切りです。</p>
    </article>
    <article class="panel-muted p-5">
      <h2 class="mt-0 text-lg font-semibold">音が出ないとき</h2>
      <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">端末の音量を確認してください。ブラウザによっては最初のタップ後に音が鳴ります。音が出なくても音符とリズムの画面は操作できます。</p>
    </article>
  </section>
  <div class="mt-8"><RelatedGames currentHref="/games/music/" /></div>
</Layout>
