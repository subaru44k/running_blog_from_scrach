---
import Layout from '../../layouts/Layout.astro';
import RelatedGames from '../../components/games/RelatedGames.astro';

const pageTitle = 'まどゲーム｜ミニゲーム';
const metaDescription = 'ぞうさんを左右に動かして、雲に乗ったいたずら者がマンションから落とす窓をキャッチする30秒の子ども向けゲームです。';
---

<Layout
  pageTitle={pageTitle}
  metaDescription={metaDescription}
  noSidebar={true}
  pageHeading="まどゲーム"
  pageLead="雲に乗ったいたずら者がマンションの窓にさわると、窓がぐらぐらして落ちてくるよ。ぞうさんを動かして、地面に落ちる前にキャッチしよう。"
>
  <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <article class="card p-5 md:p-6">
      <div class="window-shell">
        <div class="window-top">
          <div>
            <p class="window-kicker">MINI GAME</p>
            <h2 class="window-title">まどゲーム</h2>
          </div>
          <div class="window-score" id="scoreText">スコア: 0</div>
        </div>

        <div class="window-status" id="statusText" aria-live="polite">むずかしさをえらんで、スタートしよう</div>

        <div class="window-settings">
          <div class="window-field">
            <label for="difficultySelect">むずかしさ</label>
            <select id="difficultySelect" aria-label="むずかしさ">
              <option value="slow">おそい</option>
              <option value="normal" selected>ふつう</option>
              <option value="fast">はやい</option>
            </select>
          </div>
          <button class="window-btn window-btn-primary" id="startBtn" type="button">スタート</button>
          <button class="window-btn" id="widePlayBtn" type="button" aria-pressed="false">大きくあそぶ</button>
        </div>

        <div class="window-meta">
          <div class="window-chip"><span>のこり</span><strong id="timeText">30</strong></div>
          <div class="window-chip"><span>キャッチ</span><strong id="catchText">0</strong></div>
          <div class="window-chip"><span>そうさ</span><strong id="controlText">タッチOK</strong></div>
        </div>

        <div class="window-stage-wrap">
          <canvas id="windowGame" width="960" height="540" aria-label="まどゲーム。象を左右に動かして、落ちてくるまどをキャッチします。"></canvas>
          <div class="window-result" id="resultPanel" hidden>
            <div class="window-result-card">
              <p class="window-result-kicker">おしまい</p>
              <h3 id="resultTitle">よくできました</h3>
              <p id="resultBody">スコア 0</p>
              <button class="window-btn window-btn-primary" id="retryBtn" type="button">もういちど</button>
            </div>
          </div>
        </div>

        <div class="window-controls" aria-label="象を左右に動かす">
          <button class="window-move-btn" data-direction="left" type="button">← ひだり</button>
          <button class="window-move-btn" data-direction="right" type="button">みぎ →</button>
        </div>
        <p class="window-hint">操作: 画面タップ・ドラッグ、←→ / A・Dキー、ゲームパッドの左スティック・十字キー</p>

        <div class="window-help mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-700/80 dark:bg-slate-900/60">
            <h3 class="mt-0 text-base font-semibold">遊び方</h3>
            <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">雲に乗ったいたずら者が窓にさわると、窓がぐらぐらします。落ちる場所へぞうさんを動かすと、鼻を上げて自動でキャッチできます。</p>
          </div>
          <div class="rounded-2xl border border-slate-200/80 bg-white/70 p-4 dark:border-slate-700/80 dark:bg-slate-900/60">
            <h3 class="mt-0 text-base font-semibold">落としてもだいじょうぶ</h3>
            <p class="mt-2 text-sm leading-7 text-slate-600 dark:text-slate-300">取り逃しても減点はありません。窓は地面でやわらかく跳ねて、すぐ次のチャレンジが始まります。</p>
          </div>
        </div>
      </div>
    </article>

    <RelatedGames currentHref="/games/window-catch/" />
  </section>

  <style>
    :global(body.window-wide-play-lock) { overflow:hidden; touch-action:none; overscroll-behavior:none; }
    .window-shell { color:rgb(15 23 42); overscroll-behavior:contain; }
    .window-top { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; margin-bottom:1rem; }
    .window-kicker { margin:0; color:rgb(100 116 139); font-size:.72rem; font-weight:800; letter-spacing:.24em; }
    .window-title { margin:.35rem 0 0; font-size:1.65rem; }
    .window-score { border:1px solid rgba(148,163,184,.35); border-radius:999px; background:rgba(255,255,255,.88); padding:.65rem 1rem; font-weight:900; white-space:nowrap; }
    .window-status { margin-bottom:1rem; border:1px solid rgba(148,163,184,.28); border-radius:1rem; background:linear-gradient(135deg,rgba(254,249,195,.9),rgba(237,233,254,.9)); padding:.95rem 1rem; font-weight:900; }
    .window-settings { display:grid; grid-template-columns:minmax(0,1fr) auto auto; gap:.75rem; margin-bottom:1rem; }
    .window-field { display:grid; gap:.35rem; }
    .window-field label { color:rgb(71 85 105); font-size:.86rem; font-weight:800; }
    .window-field select,.window-btn { border:1px solid rgba(51,65,85,.22); border-radius:1rem; background:rgba(255,255,255,.94); color:rgb(15 23 42); padding:.8rem 1rem; font-weight:900; }
    .window-btn { cursor:pointer; transition:transform .15s ease,background-color .15s ease; }
    .window-btn:hover { transform:translateY(-1px); background:white; }
    .window-btn-primary { border-color:rgb(15 23 42); background:rgb(15 23 42); color:white; }
    .window-btn-primary:hover { background:rgb(30 41 59); }
    .window-meta { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin-bottom:1rem; }
    .window-chip { display:grid; gap:.2rem; border:1px solid rgba(148,163,184,.35); border-radius:1rem; background:rgba(255,255,255,.82); padding:.75rem .9rem; }
    .window-chip span { color:rgb(100 116 139); font-size:.75rem; font-weight:800; }
    .window-chip strong { font-size:1.2rem; line-height:1.1; }
    .window-stage-wrap { position:relative; overflow:hidden; border:1px solid rgba(51,65,85,.18); border-radius:1.25rem; background:linear-gradient(180deg,#e5f7f4,#fff1d9); box-shadow:inset 0 1px 0 rgba(255,255,255,.8); }
    #windowGame { display:block; width:100%; height:auto; aspect-ratio:16 / 9; touch-action:none; user-select:none; }
    .window-result { position:absolute; inset:0; display:grid; place-items:center; background:rgba(15,23,42,.38); padding:1rem; }
    .window-result[hidden] { display:none; }
    .window-result-card { width:min(90%,24rem); border-radius:1.25rem; background:rgba(255,255,255,.96); padding:1.4rem; text-align:center; box-shadow:0 18px 45px rgba(15,23,42,.25); }
    .window-result-card h3 { margin:.2rem 0 .5rem; font-size:1.7rem; }
    .window-result-kicker { margin:0; color:rgb(124 58 237); font-size:.74rem; font-weight:900; letter-spacing:.2em; }
    .window-controls { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; margin-top:1rem; }
    .window-move-btn { min-height:3.5rem; border:1px solid rgba(51,65,85,.22); border-radius:1rem; background:rgba(255,255,255,.94); color:rgb(15 23 42); font-weight:900; cursor:pointer; touch-action:none; user-select:none; }
    .window-move-btn:active { background:rgb(224 242 254); transform:translateY(1px); }
    .window-hint { margin:.8rem 0 0; color:rgb(100 116 139); font-size:.82rem; line-height:1.7; }

    .window-shell.is-wide-play,.window-shell:fullscreen { position:fixed; inset:0; z-index:9999; display:grid; grid-template-rows:auto auto auto minmax(0,1fr) auto; gap:.4rem; width:100vw; height:100dvh; overflow:hidden; padding:calc(.45rem + env(safe-area-inset-top)) calc(.55rem + env(safe-area-inset-right)) calc(.45rem + env(safe-area-inset-bottom)) calc(.55rem + env(safe-area-inset-left)); background:linear-gradient(180deg,#fff7ed,#eefdf8); color:rgb(15 23 42); }
    .window-shell.is-wide-play .window-top,.window-shell:fullscreen .window-top { align-items:center; margin:0; }
    .window-shell.is-wide-play .window-kicker,.window-shell.is-wide-play .window-title,.window-shell.is-wide-play .window-hint,.window-shell.is-wide-play .window-help,.window-shell:fullscreen .window-kicker,.window-shell:fullscreen .window-title,.window-shell:fullscreen .window-hint,.window-shell:fullscreen .window-help { display:none; }
    .window-shell.is-wide-play .window-status,.window-shell:fullscreen .window-status { margin:0; padding:.45rem .7rem; font-size:.88rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .window-shell.is-wide-play .window-settings,.window-shell:fullscreen .window-settings { grid-template-columns:minmax(7rem,1fr) auto auto; align-items:end; gap:.4rem; margin:0; }
    .window-shell.is-wide-play .window-field label,.window-shell:fullscreen .window-field label { display:none; }
    .window-shell.is-wide-play .window-field select,.window-shell.is-wide-play .window-btn,.window-shell:fullscreen .window-field select,.window-shell:fullscreen .window-btn { min-height:2.2rem; padding:.4rem .6rem; border-radius:.75rem; font-size:.82rem; }
    .window-shell.is-wide-play .window-meta,.window-shell:fullscreen .window-meta { position:absolute; top:calc(.45rem + env(safe-area-inset-top)); right:calc(.55rem + env(safe-area-inset-right)); z-index:2; display:flex; gap:.25rem; margin:0; pointer-events:none; }
    .window-shell.is-wide-play .window-chip,.window-shell:fullscreen .window-chip { min-width:3.15rem; gap:0; padding:.3rem .4rem; border-radius:.7rem; background:rgba(255,255,255,.92); }
    .window-shell.is-wide-play .window-chip span,.window-shell:fullscreen .window-chip span { font-size:.54rem; }
    .window-shell.is-wide-play .window-chip strong,.window-shell:fullscreen .window-chip strong { font-size:.82rem; }
    .window-shell.is-wide-play .window-stage-wrap,.window-shell:fullscreen .window-stage-wrap { align-self:center; justify-self:center; width:min(100%,calc((100dvh - 10rem)*16/9)); max-height:100%; border-radius:.8rem; }
    .window-shell.is-wide-play #windowGame,.window-shell:fullscreen #windowGame { max-height:calc(100dvh - 10rem); object-fit:contain; }
    .window-shell.is-wide-play .window-controls,.window-shell:fullscreen .window-controls { justify-self:center; width:min(38rem,100%); margin:0; }

    @media (max-width:640px) {
      .window-top { display:grid; }
      .window-score { justify-self:start; }
      .window-settings { grid-template-columns:1fr; }
      .window-meta { gap:.45rem; }
      .window-chip { padding:.6rem; }
      .window-chip strong { font-size:1rem; }
    }
    @media (pointer:fine) and (min-width:768px) { .window-controls { width:min(32rem,100%); margin-inline:auto; } }
    @media (max-height:500px) and (orientation:landscape) {
      .window-shell.is-wide-play,.window-shell:fullscreen { display:block; }
      .window-shell.is-wide-play .window-top,.window-shell.is-wide-play .window-status,.window-shell.is-wide-play .window-settings,.window-shell.is-wide-play .window-meta,.window-shell:fullscreen .window-top,.window-shell:fullscreen .window-status,.window-shell:fullscreen .window-settings,.window-shell:fullscreen .window-meta { position:absolute; z-index:3; }
      .window-shell.is-wide-play .window-top,.window-shell:fullscreen .window-top { top:calc(.4rem + env(safe-area-inset-top)); left:calc(.5rem + env(safe-area-inset-left)); }
      .window-shell.is-wide-play .window-status,.window-shell:fullscreen .window-status { display:none; }
      .window-shell.is-wide-play .window-settings,.window-shell:fullscreen .window-settings { left:50%; bottom:calc(3.5rem + env(safe-area-inset-bottom)); width:min(35rem,calc(100vw - 1rem)); transform:translateX(-50%); padding:.3rem; border-radius:.8rem; background:rgba(255,255,255,.82); }
      .window-shell.is-wide-play .window-meta,.window-shell:fullscreen .window-meta { top:calc(.4rem + env(safe-area-inset-top)); right:calc(.5rem + env(safe-area-inset-right)); }
      .window-shell.is-wide-play .window-stage-wrap,.window-shell:fullscreen .window-stage-wrap { position:absolute; top:50%; left:50%; width:min(100%,calc((100dvh - .8rem)*16/9)); max-height:calc(100dvh - .8rem); transform:translate(-50%,-50%); }
      .window-shell.is-wide-play #windowGame,.window-shell:fullscreen #windowGame { max-height:calc(100dvh - .8rem); }
      .window-shell.is-wide-play .window-controls,.window-shell:fullscreen .window-controls { position:absolute; z-index:4; bottom:calc(.35rem + env(safe-area-inset-bottom)); left:50%; width:min(31rem,calc(100vw - 1rem)); transform:translateX(-50%); }
    }
  </style>

  <script type="module">
    import { createGamepadController } from '/scripts/games/gamepad.js';
    import { createGameInputLock } from '/scripts/games/keyboard-lock.js';

    const ASSETS = {
      elephant: '/images/games/window-catch/elephant-sprite-sheet.png',
      troublemaker: '/images/games/window-catch/cloud-troublemaker.png',
    };
    const DIFFICULTIES = {
      slow: { label:'おそい', approachMs:1500, shakeMs:760, fallMs:1900, elephantSpeed:440 },
      normal: { label:'ふつう', approachMs:1050, shakeMs:600, fallMs:1500, elephantSpeed:430 },
      fast: { label:'はやい', approachMs:750, shakeMs:450, fallMs:1150, elephantSpeed:450 },
    };
    const GAME_MS = 30000;
    const PLAY_MIN_X = 70;
    const PLAY_MAX_X = 890;
    const ELEPHANT_FOOT_Y = 520;
    const ELEPHANT_DRAW_H = 190;
    const ELEPHANT_HIT_W = 150;
    const ELEPHANT_HIT_H = 145;
    const WINDOW_FLOOR_Y = 462;
    const WINDOW_W = 76;
    const WINDOW_H = 92;
    const MISS_BOUNCE_MS = 620;
    const NEXT_ROUND_MS = 420;
    const WINDOW_ANCHORS = [
      { x:190,y:142 }, { x:380,y:142 }, { x:580,y:142 }, { x:770,y:142 },
      { x:190,y:266 }, { x:380,y:266 }, { x:580,y:266 }, { x:770,y:266 },
    ];
    const ELEPHANT_FRAMES = [
      { x:0,y:0,w:683,h:768 },
      { x:683,y:0,w:683,h:768 },
      { x:1366,y:0,w:682,h:768 },
    ];

    const canvas = document.getElementById('windowGame');
    const ctx = canvas.getContext('2d');
    const scoreText = document.getElementById('scoreText');
    const statusText = document.getElementById('statusText');
    const timeText = document.getElementById('timeText');
    const catchText = document.getElementById('catchText');
    const controlText = document.getElementById('controlText');
    const difficultySelect = document.getElementById('difficultySelect');
    const startBtn = document.getElementById('startBtn');
    const widePlayBtn = document.getElementById('widePlayBtn');
    const retryBtn = document.getElementById('retryBtn');
    const resultPanel = document.getElementById('resultPanel');
    const resultTitle = document.getElementById('resultTitle');
    const resultBody = document.getElementById('resultBody');
    const shell = document.querySelector('.window-shell');
    const moveButtons = Array.from(document.querySelectorAll('.window-move-btn'));

    const images = {};
    let phase = 'title';
    let difficulty = 'normal';
    let player = { x:480,targetX:480,direction:0,lastCatchAt:-1000 };
    let round = null;
    let nextRoundAt = 0;
    let score = 0;
    let caughtCount = 0;
    let startedAt = 0;
    let lastFrameAt = 0;
    let messageUntil = 0;
    let rafId = 0;
    let pointerActive = false;
    let keyboardDirection = 0;
    let touchDirection = 0;
    let gamepadDirection = 0;
    let gamepadDirectionUntil = 0;
    let stopGamepad = null;
    let widePlayActive = false;
    let lastAnchorIndex = -1;

    const clamp = (value,min,max) => Math.max(min,Math.min(max,value));
    const lerp = (start,end,t) => start+(end-start)*t;
    const easeInOut = (t) => t<.5 ? 2*t*t : 1-Math.pow(-2*t+2,2)/2;

    function loadImage(src) {
      return new Promise((resolve) => {
        const image = new Image();
        image.onload = () => resolve(image);
        image.onerror = () => resolve(null);
        image.src = src;
      });
    }
    async function preloadAssets() {
      await Promise.all(Object.entries(ASSETS).map(async ([key,src]) => { images[key] = await loadImage(src); }));
      draw(performance.now());
    }
    function setStatus(text,durationMs=0) {
      statusText.textContent = text;
      messageUntil = durationMs ? performance.now()+durationMs : 0;
    }
    function updateHud(now=performance.now()) {
      const elapsed = phase==='playing' ? now-startedAt : 0;
      const remaining = phase==='playing' ? Math.max(0,Math.ceil((GAME_MS-elapsed)/1000)) : phase==='finished' ? 0 : 30;
      scoreText.textContent = `スコア: ${score}`;
      timeText.textContent = String(remaining);
      catchText.textContent = String(caughtCount);
    }
    function updateControlText() {
      const hasGamepad = Array.from(navigator.getGamepads?.() ?? []).some(Boolean);
      controlText.textContent = hasGamepad ? 'パッドOK' : 'タッチOK';
    }
    function resetGame() {
      difficulty = difficultySelect.value;
      player = { x:480,targetX:480,direction:0,lastCatchAt:-1000 };
      round = null;
      nextRoundAt = 0;
      lastAnchorIndex = -1;
      score = 0;
      caughtCount = 0;
      resultPanel.hidden = true;
      updateHud();
    }
    function startRound(now) {
      let anchorIndex = Math.floor(Math.random()*WINDOW_ANCHORS.length);
      if (anchorIndex===lastAnchorIndex) anchorIndex = (anchorIndex+1)%WINDOW_ANCHORS.length;
      lastAnchorIndex = anchorIndex;
      const anchor = WINDOW_ANCHORS[anchorIndex];
      const fromLeft = Math.random()<.5;
      round = {
        state:'approach', stateStartedAt:now, anchorIndex,
        x:anchor.x, y:anchor.y, rotation:0,
        riderFromX:fromLeft ? -130 : 1090,
        riderContactX:fromLeft ? anchor.x-120 : anchor.x+120,
        riderFacing:fromLeft ? 1 : -1,
      };
    }
    function startGame() {
      resetGame();
      phase = 'playing';
      startedAt = performance.now();
      lastFrameAt = startedAt;
      startRound(startedAt);
      setStatus(`${DIFFICULTIES[difficulty].label}モード。まどをキャッチしよう`);
      startBtn.textContent = 'さいしょから';
      ensureGamepadController();
      startLoop();
    }
    function finishGame() {
      phase = 'finished';
      round = null;
      stopLoop();
      updateHud();
      resultTitle.textContent = score>=12 ? 'まどキャッチ名人！' : score>=6 ? 'すごいキャッチ！' : 'またやってみよう';
      resultBody.textContent = `スコア ${score}、キャッチ ${caughtCount}こ`;
      resultPanel.hidden = false;
      setStatus('30びょう おしまい');
      draw(performance.now());
    }
    function isCaught(fallingWindow) {
      if (!round || round.state!=='falling') return false;
      return Math.abs(fallingWindow.x-player.x)<=ELEPHANT_HIT_W/2+WINDOW_W/2
        && fallingWindow.y+WINDOW_H/2>=ELEPHANT_FOOT_Y-ELEPHANT_HIT_H
        && fallingWindow.y-WINDOW_H/2<=ELEPHANT_FOOT_Y;
    }
    function updateRound(now) {
      if (!round) {
        if (now>=nextRoundAt) startRound(now);
        return;
      }
      const settings = DIFFICULTIES[difficulty];
      if (round.state==='approach') {
        const progress = clamp((now-round.stateStartedAt)/settings.approachMs,0,1);
        if (progress>=1) {
          round.state = 'shaking';
          round.stateStartedAt = now;
          setStatus('まどが ぐらぐら！',settings.shakeMs);
        }
        return;
      }
      if (round.state==='shaking') {
        const progress = clamp((now-round.stateStartedAt)/settings.shakeMs,0,1);
        round.rotation = Math.sin(progress*Math.PI*10)*.11;
        if (progress>=1) {
          round.state = 'falling';
          round.stateStartedAt = now;
          round.rotation = 0;
          setStatus('まどが おちるよ！',600);
        }
        return;
      }
      if (round.state==='falling') {
        const t = clamp((now-round.stateStartedAt)/settings.fallMs,0,1);
        round.y = lerp(WINDOW_ANCHORS[round.anchorIndex].y,WINDOW_FLOOR_Y,easeInOut(t));
        round.x = WINDOW_ANCHORS[round.anchorIndex].x+Math.sin(t*Math.PI)*Math.sin(round.anchorIndex*2.4)*18;
        round.rotation = Math.sin(t*Math.PI*3)*.13;
        if (isCaught(round)) {
          score += 1;
          caughtCount += 1;
          player.lastCatchAt = now;
          round = null;
          nextRoundAt = now+NEXT_ROUND_MS;
          setStatus('ナイスキャッチ！',700);
        } else if (t>=1) {
          round.state = 'miss';
          round.stateStartedAt = now;
          round.y = WINDOW_FLOOR_Y;
          round.rotation = 0;
          setStatus('ぽよん。つぎをねらおう',700);
        }
        return;
      }
      const missT = clamp((now-round.stateStartedAt)/MISS_BOUNCE_MS,0,1);
      round.y = WINDOW_FLOOR_Y-Math.abs(Math.sin(missT*Math.PI*2))*28*(1-missT);
      round.rotation = Math.sin(missT*Math.PI*2)*.07;
      if (missT>=1) {
        round = null;
        nextRoundAt = now+NEXT_ROUND_MS;
      }
    }
    function updatePlayer(dt,now) {
      if (gamepadDirectionUntil<now) gamepadDirection = 0;
      const direction = keyboardDirection || touchDirection || gamepadDirection;
      if (direction) {
        player.x += direction*DIFFICULTIES[difficulty].elephantSpeed*dt;
        player.targetX = player.x;
      } else {
        player.x += (player.targetX-player.x)*Math.min(1,dt*8);
      }
      player.x = clamp(player.x,PLAY_MIN_X,PLAY_MAX_X);
      player.direction = direction || Math.sign(player.targetX-player.x);
    }
    function step(now) {
      if (phase!=='playing') { stopLoop(); draw(now); return; }
      const dt = Math.min(.04,(now-lastFrameAt)/1000 || 0);
      lastFrameAt = now;
      if (now-startedAt>=GAME_MS) finishGame();
      else {
        updatePlayer(dt,now);
        updateRound(now);
        updateHud(now);
        if (messageUntil && now>messageUntil) setStatus(`${DIFFICULTIES[difficulty].label}モード。まどをキャッチしよう`);
      }
      draw(now);
      if (phase==='playing') rafId = requestAnimationFrame(step);
    }
    function startLoop() { if (!rafId) { lastFrameAt = performance.now(); rafId = requestAnimationFrame(step); } }
    function stopLoop() { if (rafId) { cancelAnimationFrame(rafId); rafId = 0; } }

    function drawWindowAt(x,y,rotation=0,alpha=1) {
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.translate(x,y);
      ctx.rotate(rotation);
      ctx.fillStyle = '#f8fafc'; ctx.strokeStyle = '#475569'; ctx.lineWidth = 6;
      ctx.beginPath(); ctx.roundRect(-WINDOW_W/2,-WINDOW_H/2,WINDOW_W,WINDOW_H,5); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#bde9ff';
      ctx.fillRect(-WINDOW_W/2+9,-WINDOW_H/2+9,WINDOW_W-18,WINDOW_H-18);
      ctx.strokeStyle = '#64748b'; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(0,-WINDOW_H/2+7); ctx.lineTo(0,WINDOW_H/2-7); ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,.75)';
      ctx.beginPath(); ctx.moveTo(-25,-31); ctx.lineTo(-5,-31); ctx.lineTo(-25,-4); ctx.closePath(); ctx.fill();
      ctx.restore();
    }
    function drawBuilding() {
      const sky = ctx.createLinearGradient(0,0,0,canvas.height);
      sky.addColorStop(0,'#82d8ff'); sky.addColorStop(.72,'#e8f8ff'); sky.addColorStop(1,'#b9e98e');
      ctx.fillStyle = sky; ctx.fillRect(0,0,canvas.width,canvas.height);
      ctx.fillStyle = '#fff4a8'; ctx.beginPath(); ctx.arc(72,64,34,0,Math.PI*2); ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,.72)';
      for (const [x,y,s] of [[125,58,1],[830,45,.8]]) {
        ctx.beginPath(); ctx.ellipse(x,y,44*s,15*s,0,0,Math.PI*2); ctx.ellipse(x+35*s,y+2*s,35*s,12*s,0,0,Math.PI*2); ctx.fill();
      }
      ctx.fillStyle = '#f4c98c'; ctx.strokeStyle = '#a96d4a'; ctx.lineWidth = 6;
      ctx.beginPath(); ctx.roundRect(90,55,780,390,10); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#d98562'; ctx.fillRect(78,45,804,25);
      ctx.fillStyle = '#ffe8bd';
      for (let col=1; col<4; col++) ctx.fillRect(90+col*195-4,70,8,375);
      ctx.fillStyle = '#c77a57';
      for (const y of [205,329]) ctx.fillRect(90,y,780,10);
      ctx.fillStyle = '#9cc774'; ctx.fillRect(0,445,canvas.width,95);
      ctx.fillStyle = '#7caf5b'; ctx.fillRect(0,445,canvas.width,13);
      for (let index=0; index<WINDOW_ANCHORS.length; index++) {
        if (round?.anchorIndex===index && round.state!=='approach') continue;
        const anchor = WINDOW_ANCHORS[index];
        drawWindowAt(anchor.x,anchor.y);
        ctx.fillStyle = index%2 ? '#ef8fa3' : '#7cc58a';
        ctx.fillRect(anchor.x-31,anchor.y+54,62,8);
        ctx.fillStyle = '#f4f0d7';
        ctx.beginPath(); ctx.arc(anchor.x-18,anchor.y+50,8,0,Math.PI*2); ctx.arc(anchor.x+15,anchor.y+49,9,0,Math.PI*2); ctx.fill();
      }
      ctx.fillStyle = '#855a46'; ctx.fillRect(445,350,70,95);
      ctx.fillStyle = '#d9b28c'; ctx.beginPath(); ctx.arc(500,397,5,0,Math.PI*2); ctx.fill();
    }
    function riderPosition(now) {
      if (!round) return { x:720,y:70,facing:1 };
      const anchor = WINDOW_ANCHORS[round.anchorIndex];
      let x = round.riderContactX;
      if (round.state==='approach') {
        const progress = clamp((now-round.stateStartedAt)/DIFFICULTIES[difficulty].approachMs,0,1);
        x = lerp(round.riderFromX,round.riderContactX,easeInOut(progress));
      }
      return { x,y:anchor.y-93+Math.sin(now/130)*3,facing:round.riderFacing };
    }
    function drawTroublemaker(now) {
      const rider = riderPosition(now);
      ctx.save(); ctx.translate(rider.x,rider.y); ctx.scale(rider.facing,1);
      if (images.troublemaker) ctx.drawImage(images.troublemaker,-110,-72,220,147);
      else {
        ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.ellipse(0,35,86,30,0,0,Math.PI*2); ctx.fill();
        ctx.fillStyle = '#7e22ce'; ctx.beginPath(); ctx.arc(0,-5,34,0,Math.PI*2); ctx.fill();
      }
      ctx.restore();
    }
    function currentElephantFrame(now) {
      if (now-player.lastCatchAt<430) return 2;
      if (phase==='playing' && (Math.abs(player.direction)>0 || Math.abs(player.targetX-player.x)>5)) return 1;
      return 0;
    }
    function drawElephant(now) {
      const image = images.elephant;
      const frameIndex = currentElephantFrame(now);
      if (!image) {
        ctx.fillStyle = '#78c7f4'; ctx.beginPath(); ctx.ellipse(player.x,ELEPHANT_FOOT_Y-60,65,52,0,0,Math.PI*2); ctx.fill();
        ctx.lineWidth = 18; ctx.strokeStyle = '#78c7f4'; ctx.beginPath(); ctx.moveTo(player.x+35,ELEPHANT_FOOT_Y-70); ctx.quadraticCurveTo(player.x+75,ELEPHANT_FOOT_Y-80,player.x+70,ELEPHANT_FOOT_Y-115); ctx.stroke(); return;
      }
      const box = ELEPHANT_FRAMES[frameIndex];
      const dw = ELEPHANT_DRAW_H*(box.w/box.h);
      ctx.save();
      ctx.translate(player.x,ELEPHANT_FOOT_Y);
      if (player.direction<0) ctx.scale(-1,1);
      ctx.drawImage(image,box.x,box.y,box.w,box.h,-dw/2,-ELEPHANT_DRAW_H,dw,ELEPHANT_DRAW_H);
      ctx.restore();
    }
    function drawActiveWindow(now) {
      if (!round || round.state==='approach') return;
      const alpha = round.state==='miss' ? 1-clamp((now-round.stateStartedAt)/MISS_BOUNCE_MS,0,1)*.45 : 1;
      drawWindowAt(round.x,round.y,round.rotation,alpha);
    }
    function draw(now) {
      ctx.clearRect(0,0,canvas.width,canvas.height);
      drawBuilding();
      drawTroublemaker(now);
      drawActiveWindow(now);
      drawElephant(now);
      if (phase==='title') {
        ctx.fillStyle = 'rgba(255,255,255,.72)'; ctx.fillRect(0,0,canvas.width,canvas.height);
        ctx.fillStyle = '#334155'; ctx.textAlign = 'center'; ctx.font = '800 34px system-ui,sans-serif'; ctx.fillText('スタートで はじめよう',canvas.width/2,244);
        ctx.font = '800 22px system-ui,sans-serif'; ctx.fillText('おちるまどを ぞうさんでキャッチ！',canvas.width/2,284);
      }
    }

    function canvasX(event) {
      const rect = canvas.getBoundingClientRect();
      return ((event.clientX-rect.left)/rect.width)*canvas.width;
    }
    function moveToPointer(event) {
      player.targetX = clamp(canvasX(event),PLAY_MIN_X,PLAY_MAX_X);
      if (phase==='title') startGame();
    }
    function clearTouchDirection() { touchDirection = 0; }
    function ensureGamepadController() {
      if (stopGamepad) return;
      stopGamepad = createGamepadController({
        onDirection:(direction) => {
          if (direction==='left') gamepadDirection = -1;
          else if (direction==='right') gamepadDirection = 1;
          else return;
          gamepadDirectionUntil = performance.now()+150;
        },
        onPrimary:() => { if (phase!=='playing') startGame(); },
        directionRepeatMs:60,
      });
    }
    function updateWidePlayButton() {
      widePlayBtn.textContent = widePlayActive ? 'もどる' : '大きくあそぶ';
      widePlayBtn.setAttribute('aria-pressed',widePlayActive ? 'true' : 'false');
    }
    async function enterWidePlay() {
      widePlayActive = true; shell.classList.add('is-wide-play'); document.body.classList.add('window-wide-play-lock'); updateWidePlayButton(); draw(performance.now());
      try { if (!document.fullscreenElement && shell.requestFullscreen) await shell.requestFullscreen(); } catch {}
      try { await screen.orientation?.lock?.('landscape'); } catch {}
    }
    async function exitWidePlay({skipNativeExit=false}={}) {
      widePlayActive = false; shell.classList.remove('is-wide-play'); document.body.classList.remove('window-wide-play-lock'); updateWidePlayButton(); draw(performance.now());
      try { screen.orientation?.unlock?.(); } catch {}
      if (!skipNativeExit && document.fullscreenElement===shell) { try { await document.exitFullscreen(); } catch {} }
    }

    startBtn.addEventListener('click',startGame);
    retryBtn.addEventListener('click',startGame);
    widePlayBtn.addEventListener('click',() => { if (widePlayActive) void exitWidePlay(); else void enterWidePlay(); });
    difficultySelect.addEventListener('change',(event) => {
      difficulty = event.target.value;
      if (phase!=='playing') { setStatus(`${DIFFICULTIES[difficulty].label}モードであそぶよ`); draw(performance.now()); }
    });
    canvas.addEventListener('pointerdown',(event) => {
      pointerActive = true;
      try { canvas.setPointerCapture?.(event.pointerId); } catch {}
      moveToPointer(event);
    });
    canvas.addEventListener('pointermove',(event) => { if (pointerActive) moveToPointer(event); });
    canvas.addEventListener('pointerup',() => { pointerActive = false; });
    canvas.addEventListener('pointercancel',() => { pointerActive = false; });
    for (const button of moveButtons) {
      button.addEventListener('pointerdown',(event) => {
        event.preventDefault();
        touchDirection = button.dataset.direction==='left' ? -1 : 1;
        try { button.setPointerCapture?.(event.pointerId); } catch {}
      });
      button.addEventListener('pointerup',clearTouchDirection);
      button.addEventListener('pointercancel',clearTouchDirection);
      button.addEventListener('lostpointercapture',clearTouchDirection);
    }
    const stopKeyboardLock = createGameInputLock({
      keys:['ArrowLeft','ArrowRight','a','d',' '],
      onKey:(key) => {
        if (key==='arrowleft' || key==='a') keyboardDirection = -1;
        if (key==='arrowright' || key==='d') keyboardDirection = 1;
        if (key===' ' && phase!=='playing') startGame();
      },
    });
    window.addEventListener('keyup',(event) => {
      const key = event.key.toLowerCase();
      if ((key==='arrowleft' || key==='a') && keyboardDirection===-1) keyboardDirection = 0;
      if ((key==='arrowright' || key==='d') && keyboardDirection===1) keyboardDirection = 0;
    },{capture:true});
    window.addEventListener('gamepadconnected',() => { updateControlText(); ensureGamepadController(); });
    window.addEventListener('gamepaddisconnected',() => { updateControlText(); gamepadDirection = 0; gamepadDirectionUntil = 0; });
    document.addEventListener('fullscreenchange',() => { if (widePlayActive && document.fullscreenElement!==shell) void exitWidePlay({skipNativeExit:true}); });
    window.addEventListener('pagehide',() => {
      if (widePlayActive) void exitWidePlay({skipNativeExit:true});
      stopGamepad?.(); stopKeyboardLock(); stopLoop();
    },{once:true});

    resetGame();
    updateControlText();
    ensureGamepadController();
    preloadAssets();
  </script>
</Layout>
