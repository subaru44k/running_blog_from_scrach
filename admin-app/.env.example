# Workout import: Garmin-first by default; Fitbit credentials are used on fallback days.
# Garmin local login/setup: docs/runbooks/garmin-local.md
# CLI override: --source auto|garmin|fitbit; preview: --dry-run
TOKEN_S3_BUCKET=your-secrets-bucket
TOKEN_S3_KEY=fitbit/token.json
FITBIT_CLIENT_ID=your-client-id
FITBIT_CLIENT_SECRET=your-client-secret
AWS_REGION=ap-northeast-1

# Optional overrides
FITBIT_IMPORT_TZ_OFFSET=540
FITBIT_DISTANCE_RESOLUTION=1sec
FITBIT_DEFAULT_CATEGORY=練習(デフォルト)
FITBIT_DEFAULT_AUTHOR=Subaru
FITBIT_DEFAULT_STATUS=draft
FITBIT_IMPORT_DRY_RUN=false
FITBIT_SPLIT_DEBUG=false
FITBIT_RUN_ACTIVITY_NAMES=Structured Workout,Run,Treadmill run,Trail run,Incline run
FITBIT_RUN_ACTIVITY_IDS=91060
